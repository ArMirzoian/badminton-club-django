# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (для локальной разработки)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/badminton

# Для production (Render.com заполнит автоматически)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings.dev

# Email (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Timezone
TIME_ZONE=Europe/Moscow

# Venue Info
VENUE_ADDRESS=Электролитный пр.3, стр.5\nС/К ВЫСШАЯ ЛИГА\nРасписание 21:00-23:00\nСтоимость 800 руб.

# Game Settings
MAX_PLAYERS=18
ADMIN_IDS=140657895,156746885,357556016

# Security (для production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Google Sheets (опционально, для миграции)
# GOOGLE_CREDS_PATH=/path/to/credentials.json
# SHEET_NAME=badminton_bookings
