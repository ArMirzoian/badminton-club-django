/**
 * Google Apps Script для автоматизации записи на бадминтон
 * 
 * Возможности:
 * - Автоматическое открытие записи в понедельник 00:01
 * - Автоматическое закрытие записи в среду 17:00
 * - Email-рассылка приглашений
 * - Email-рассылка напоминаний
 * - Автоматическое формирование основы/резерва
 * - Интеграция с вашей текущей Google Sheets для статистики
 */

// ==========================================
// КОНФИГУРАЦИЯ (настройте под себя)
// ==========================================

const CONFIG = {
  // ID вашей Google-таблицы для статистики (та, что используете сейчас)
  STATS_SHEET_ID: 'ВАШ_ID_ТАБЛИЦЫ_СТАТИСТИКИ',
  
  // ID шаблона формы (создадите один раз)
  FORM_TEMPLATE_ID: 'ID_ШАБЛОНА_ФОРМЫ',
  
  // ID папки для хранения форм и ответов
  FORMS_FOLDER_ID: 'ID_ПАПКИ_В_GOOGLE_DRIVE',
  
  // Лимиты
  MAX_PLAYERS: 18,
  
  // Адрес площадки
  VENUE_ADDRESS: 'Электролитный пр.3, стр.5\nС/К ВЫСШАЯ ЛИГА\nРасписание 21:00-23:00\nСтоимость 800 руб.',
  
  // Email-адреса всех игроков
  PLAYERS_EMAILS: [
    'player1@example.com',
    'player2@example.com',
    // ... добавьте всех из KNOWN_USERS
  ]
};

// ==========================================
// ОСНОВНЫЕ ФУНКЦИИ
// ==========================================

/**
 * Открыть запись (запускается в понедельник 00:01)
 */
function openRegistration() {
  const gameDate = getNextWednesday();
  const formattedDate = Utilities.formatDate(gameDate, 'Europe/Moscow', 'dd.MM.yyyy');
  
  Logger.log(`Открытие записи на ${formattedDate}`);
  
  // 1. Создать новую форму из шаблона
  const newForm = createFormFromTemplate(formattedDate);
  const formUrl = newForm.getPublishedUrl();
  
  // 2. Создать таблицу для ответов
  const responseSheet = createResponseSheet(formattedDate);
  newForm.setDestination(FormApp.DestinationType.SPREADSHEET, responseSheet.getId());
  
  // 3. Разослать приглашения
  sendInvitations(formUrl, formattedDate);
  
  Logger.log(`✅ Запись открыта: ${formUrl}`);
  
  // Сохранить данные о текущей форме
  saveCurrentFormData(newForm.getId(), responseSheet.getId(), gameDate);
}

/**
 * Закрыть запись (запускается в среду 17:00)
 */
function closeRegistration() {
  const currentFormData = getCurrentFormData();
  
  if (!currentFormData) {
    Logger.log('Нет открытой формы');
    return;
  }
  
  const form = FormApp.openById(currentFormData.formId);
  const sheet = SpreadsheetApp.openById(currentFormData.sheetId);
  
  // 1. Закрыть форму
  form.setAcceptingResponses(false);
  
  // 2. Обработать ответы (основа/резерв)
  const results = processResponses(sheet);
  
  // 3. Разослать итоговый список
  sendFinalList(results);
  
  // 4. Записать статистику в основную таблицу
  recordToStatsSheet(results, currentFormData.gameDate);
  
  Logger.log('✅ Запись закрыта');
}

/**
 * Напомнить неответившим (вторник 09:45)
 */
function sendReminders() {
  const currentFormData = getCurrentFormData();
  
  if (!currentFormData) {
    Logger.log('Нет открытой формы');
    return;
  }
  
  const sheet = SpreadsheetApp.openById(currentFormData.sheetId);
  const respondedEmails = getRespondedEmails(sheet);
  
  // Найти тех, кто не ответил
  const notResponded = CONFIG.PLAYERS_EMAILS.filter(
    email => !respondedEmails.includes(email)
  );
  
  // Отправить напоминания
  const form = FormApp.openById(currentFormData.formId);
  const formUrl = form.getPublishedUrl();
  
  notResponded.forEach(email => {
    sendReminderEmail(email, formUrl);
  });
  
  Logger.log(`📧 Отправлено напоминаний: ${notResponded.length}`);
}

// ==========================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ==========================================

/**
 * Получить следующую среду
 */
function getNextWednesday() {
  const today = new Date();
  const daysUntilWed = (3 - today.getDay() + 7) % 7;
  const wednesday = new Date(today);
  wednesday.setDate(today.getDate() + daysUntilWed);
  return wednesday;
}

/**
 * Создать форму из шаблона
 */
function createFormFromTemplate(dateStr) {
  const template = FormApp.openById(CONFIG.FORM_TEMPLATE_ID);
  const folder = DriveApp.getFolderById(CONFIG.FORMS_FOLDER_ID);
  
  const newForm = template.duplicate();
  newForm.setTitle(`Запись на бадминтон - ${dateStr}`);
  newForm.setDescription(
    `Запись на игру в среду ${dateStr}\n` +
    `Адрес: ${CONFIG.VENUE_ADDRESS}\n\n` +
    `⚠️ ВАЖНО:\n` +
    `• Основа: первые ${CONFIG.MAX_PLAYERS} человек\n` +
    `• Резерв: с ${CONFIG.MAX_PLAYERS + 1}-го места\n` +
    `• Ответы принимаются до среды 17:00`
  );
  
  // Переместить в папку
  const file = DriveApp.getFileById(newForm.getId());
  file.moveTo(folder);
  
  return newForm;
}

/**
 * Создать таблицу для ответов
 */
function createResponseSheet(dateStr) {
  const folder = DriveApp.getFolderById(CONFIG.FORMS_FOLDER_ID);
  const sheet = SpreadsheetApp.create(`Бадминтон - Ответы ${dateStr}`);
  
  const file = DriveApp.getFileById(sheet.getId());
  file.moveTo(folder);
  
  return sheet;
}

/**
 * Отправить приглашения
 */
function sendInvitations(formUrl, dateStr) {
  const subject = `🏸 Запись на бадминтон ${dateStr}`;
  const body = `
Привет!

Открыта запись на игру в среду ${dateStr}.

Адрес:
${CONFIG.VENUE_ADDRESS}

📝 Ответьте на вопрос: вы с нами?
${formUrl}

⚠️ Важно:
• Основа: первые ${CONFIG.MAX_PLAYERS} человек
• Ответы принимаются до среды 17:00
• Можно изменить ответ, перейдя по ссылке из письма-подтверждения

До встречи на площадке! 🎾
  `;
  
  CONFIG.PLAYERS_EMAILS.forEach(email => {
    try {
      MailApp.sendEmail(email, subject, body);
    } catch (e) {
      Logger.log(`Ошибка отправки на ${email}: ${e}`);
    }
  });
  
  Logger.log(`📧 Разослано приглашений: ${CONFIG.PLAYERS_EMAILS.length}`);
}

/**
 * Отправить напоминание
 */
function sendReminderEmail(email, formUrl) {
  const subject = '⏰ Напоминание: запись на бадминтон';
  const body = `
Привет!

Это напоминание: пожалуйста, ответьте на запись.

${formUrl}

Запись закроется в среду в 17:00.
  `;
  
  try {
    MailApp.sendEmail(email, subject, body);
  } catch (e) {
    Logger.log(`Ошибка отправки напоминания на ${email}: ${e}`);
  }
}

/**
 * Получить список ответивших email
 */
function getRespondedEmails(sheet) {
  const data = sheet.getSheets()[0].getDataRange().getValues();
  const emails = [];
  
  // Пропускаем заголовок (строка 1)
  for (let i = 1; i < data.length; i++) {
    const email = data[i][1]; // Столбец B - email
    if (email) {
      emails.push(email);
    }
  }
  
  return emails;
}

/**
 * Обработать ответы (основа/резерв/отказы)
 */
function processResponses(sheet) {
  const data = sheet.getSheets()[0].getDataRange().getValues();
  
  const main = [];
  const reserve = [];
  const declined = [];
  
  // Пропускаем заголовок
  for (let i = 1; i < data.length; i++) {
    const timestamp = data[i][0];
    const email = data[i][1];
    const name = data[i][2];
    const telegramId = data[i][3];
    const response = data[i][4]; // "Буду" или "Не буду"
    
    if (response === 'Буду') {
      const entry = {
        timestamp: timestamp,
        email: email,
        name: name,
        telegramId: telegramId
      };
      
      if (main.length < CONFIG.MAX_PLAYERS) {
        main.push(entry);
      } else {
        reserve.push(entry);
      }
    } else if (response === 'Не буду') {
      declined.push({
        email: email,
        name: name,
        telegramId: telegramId
      });
    }
  }
  
  return { main, reserve, declined };
}

/**
 * Отправить итоговый список
 */
function sendFinalList(results) {
  const subject = '📋 Итоговый список на игру';
  
  let body = '🟢 ОСНОВА:\n';
  results.main.forEach((p, i) => {
    body += `${i + 1}. ${p.name}\n`;
  });
  
  if (results.reserve.length > 0) {
    body += '\n🟡 РЕЗЕРВ:\n';
    results.reserve.forEach((p, i) => {
      body += `${i + 1}. ${p.name}\n`;
    });
  }
  
  if (results.declined.length > 0) {
    body += '\n❌ НЕ БУДУТ:\n';
    results.declined.forEach(p => {
      body += `• ${p.name}\n`;
    });
  }
  
  // Отправить всем, кто в основе
  results.main.forEach(p => {
    try {
      MailApp.sendEmail(p.email, subject, body);
    } catch (e) {
      Logger.log(`Ошибка отправки итогов на ${p.email}: ${e}`);
    }
  });
  
  Logger.log('📧 Разослан итоговый список');
}

/**
 * Записать в таблицу статистики
 */
function recordToStatsSheet(results, gameDate) {
  const statsSheet = SpreadsheetApp.openById(CONFIG.STATS_SHEET_ID);
  const sheet = statsSheet.getSheets()[0];
  
  const dateStr = Utilities.formatDate(gameDate, 'Europe/Moscow', 'yyyy-MM-dd');
  
  // Записываем основу
  results.main.forEach(p => {
    sheet.appendRow([
      dateStr,
      'основа',
      p.name,
      p.telegramId || '',
      Utilities.formatDate(p.timestamp, 'Europe/Moscow', 'yyyy-MM-dd HH:mm:ss')
    ]);
  });
  
  // Записываем резерв
  results.reserve.forEach(p => {
    sheet.appendRow([
      dateStr,
      'резерв',
      p.name,
      p.telegramId || '',
      Utilities.formatDate(p.timestamp, 'Europe/Moscow', 'yyyy-MM-dd HH:mm:ss')
    ]);
  });
  
  // Записываем отказы
  results.declined.forEach(p => {
    sheet.appendRow([
      dateStr,
      'отказ',
      p.name,
      p.telegramId || '',
      ''
    ]);
  });
  
  Logger.log('✅ Данные записаны в таблицу статистики');
}

/**
 * Сохранить данные о текущей форме
 */
function saveCurrentFormData(formId, sheetId, gameDate) {
  const props = PropertiesService.getScriptProperties();
  props.setProperties({
    'currentFormId': formId,
    'currentSheetId': sheetId,
    'currentGameDate': gameDate.toISOString()
  });
}

/**
 * Получить данные о текущей форме
 */
function getCurrentFormData() {
  const props = PropertiesService.getScriptProperties();
  const formId = props.getProperty('currentFormId');
  const sheetId = props.getProperty('currentSheetId');
  const gameDateStr = props.getProperty('currentGameDate');
  
  if (!formId || !sheetId || !gameDateStr) {
    return null;
  }
  
  return {
    formId: formId,
    sheetId: sheetId,
    gameDate: new Date(gameDateStr)
  };
}

// ==========================================
// НАСТРОЙКА ТРИГГЕРОВ (выполнить один раз)
// ==========================================

/**
 * Установить все триггеры
 * ВЫПОЛНИТЕ ЭТУ ФУНКЦИЮ ОДИН РАЗ ВРУЧНУЮ
 */
function setupTriggers() {
  // Удалить существующие триггеры
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(trigger => ScriptApp.deleteTrigger(trigger));
  
  // Понедельник 00:01 - открыть запись
  ScriptApp.newTrigger('openRegistration')
    .timeBased()
    .onWeekDay(ScriptApp.WeekDay.MONDAY)
    .atHour(0)
    .nearMinute(1)
    .inTimezone('Europe/Moscow')
    .create();
  
  // Вторник 09:45 - напомнить неответившим
  ScriptApp.newTrigger('sendReminders')
    .timeBased()
    .onWeekDay(ScriptApp.WeekDay.TUESDAY)
    .atHour(9)
    .nearMinute(45)
    .inTimezone('Europe/Moscow')
    .create();
  
  // Среда 17:00 - закрыть запись
  ScriptApp.newTrigger('closeRegistration')
    .timeBased()
    .onWeekDay(ScriptApp.WeekDay.WEDNESDAY)
    .atHour(17)
    .nearMinute(0)
    .inTimezone('Europe/Moscow')
    .create();
  
  Logger.log('✅ Триггеры установлены');
}

/**
 * Удалить все триггеры
 */
function deleteTriggers() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(trigger => ScriptApp.deleteTrigger(trigger));
  Logger.log('✅ Триггеры удалены');
}
